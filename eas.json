{
  "cli": {
    "version": ">= 10.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "scheme": "RecipeApp"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "scheme": "RecipeApp"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "scheme": "RecipeApp"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ENV_FILE": "true"
      },
      "ios": {
        "resourceClass": "m-medium",
        "scheme": "RecipeApp"
      }
    },
    "testflight": {
      "extends": "production",
      "ios": {
        "simulator": false,
        "scheme": "RecipeApp"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "khkeks@gmail.com",
        "ascAppId": "6758878627",
        "appleTeamId": "ELD3N9M4AP"
      }
    }
  }
}
