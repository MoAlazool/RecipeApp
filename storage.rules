rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Recipe thumbnails - allow authenticated read
    match /recipes/{userId}/{recipeId}/{fileName} {
      // Allow authenticated users to read any recipe thumbnail
      allow read: if request.auth != null;
      // Only owner can write
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Recipe images - allow authenticated read (alternative path format)
    match /recipe_images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // User avatars - allow authenticated read
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Group avatars - allow authenticated read
    match /group_avatars/{groupId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
